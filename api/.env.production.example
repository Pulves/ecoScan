POSTGRES_PASSWORD=generate-a-random-database-password
SECRET_KEY=generate-at-least-64-random-characters
ENVIRONMENT=production
ECOSCAN_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
PUBLIC_BASE_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://www.example.com
API_DOCS_ENABLED=false
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
PASSWORD_RESET_EXPOSE_TOKEN=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=EcoScan
SMTP_USE_TLS=true
SMTP_USE_SSL=false
IMAGE_RETENTION_DAYS=90
ECOSCAN_DEVICE=cpu
ECOSCAN_MODEL_HOST_PATH=C:/caminho/para/best.pt
