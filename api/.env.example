POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql+psycopg://postgres:replace-with-a-random-database-password@localhost:5432/ecoscan
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=*
API_DOCS_ENABLED=true
SECRET_KEY=replace-with-at-least-64-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
PASSWORD_RESET_EXPOSE_TOKEN=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=EcoScan
SMTP_USE_TLS=true
SMTP_USE_SSL=false
IMAGE_RETENTION_DAYS=90
ECOSCAN_DEVICE=cpu
ECOSCAN_MODEL_HOST_PATH=C:/caminho/para/best.pt
