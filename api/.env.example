DATABASE_URL=postgresql+psycopg://postgres:postgresPassword@localhost:5432/ecoscan
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
PASSWORD_RESET_EXPOSE_TOKEN=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=EcoScan
SMTP_USE_TLS=true
SMTP_USE_SSL=false
IMAGE_RETENTION_DAYS=90
ECOSCAN_DEVICE=cpu
ECOSCAN_MODEL_HOST_PATH=C:/caminho/para/best.pt
